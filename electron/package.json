{
  "name": "classdash-windows",
  "version": "1.0.0",
  "description": "Windows wrapper for ClassDash — the Electron equivalent of the macOS app's mac/16-summary.swift",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.artem.svodka",
    "productName": "ClassDash",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "ClassDash-v${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "ProjectTemplate",
        "filter": [
          "*.js",
          "settings.example.json",
          "refresh-icon.png",
          "freshcheck-icon.png",
          "settings-icon.png",
          "loading-icon.png",
          "loading-icon-light.png",
          "stop-icon.png"
        ]
      },
      {
        "from": "..",
        "to": "ProjectTemplate",
        "filter": [
          "package.json",
          "node_modules/**"
        ]
      }
    ]
  }
}
